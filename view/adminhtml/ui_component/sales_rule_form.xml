<?xml version="1.0" encoding="UTF-8"?>
<!--
/**
 * Adds the field to enter gift SKU onto sales rule form
 *
 * @category   C4B
 * @package    C4B_FreeProduct
 * @author     Dominik Meglič <meglic@code4business.de>
 * @copyright  code4business Software GmbH
 * @license    http://opensource.org/licenses/osl-3.0.php
 */
-->
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <fieldset name="actions">
        <field name="gift_sku">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Gift SKU</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">sales_rule</item>
                    <item name="dataScope" xsi:type="string">gift_sku</item>
                    <item name="sortOrder" xsi:type="number">1</item>
                    <item name="notice" xsi:type="string" translate="true">Only simple and virtual types are supported.</item>
                </item>
            </argument>
        </field>
        <field name="gift_per_qty">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Gift per Qty</item>
                    <item name="dataType" xsi:type="string">number</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">sales_rule</item>
                    <item name="dataScope" xsi:type="string">gift_per_qty</item>
                    <item name="sortOrder" xsi:type="number">2</item>
                    <item name="notice" xsi:type="string" translate="true">Qty of product A needed per gift. Decimals allowed.</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                        <item name="validate-number" xsi:type="boolean">true</item>
                        <item name="validate-greater-than-zero" xsi:type="boolean">true</item>
                    </item>
                    <item name="depends" xsi:type="array">
                        <item name="simple_action" xsi:type="array">
                            <item name="value" xsi:type="string">add_gift_per_qty</item>
                        </item>
                    </item>
                </item>
            </argument>
        </field>
    </fieldset>
</form>
